# Optional PUBLIC browser configuration for the six verified F2 contracts.
# Leave absent/empty for the explicitly unavailable integration state.
# A configured origin activates the real adapter; Laravel remains authority.
# Set only after approved Laravel Origin/Host/cookie deployment rules are verified.
# Production requires HTTPS and an origin only: no path, credentials, query or fragment.
NEXT_PUBLIC_API_ORIGIN=

# Published local development topology: frontend http://localhost:3000.
# Use the actual isolated backend origin, e.g. http://localhost:3842, only in development.

# No Laravel secrets, session keys, credentials, bearer tokens or database values belong here.
